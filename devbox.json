{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.11.0/.schema/devbox.schema.json",
  "packages": [
    "gcc@latest",
    "cmake@latest",
    "ninja@latest",
    "gitlab-ci-local@latest",
    "vscode@latest",
    "cloc@latest",
    "python@latest",
    "doxygen@latest",
    "mkdocs@latest",
    "gdb@latest"
  ],
  "shell": {
    "init_hook": [
      ". ${DEVBOX_PROJECT_ROOT}/.venv/bin/activate",
      "# the equals sign disambiguates from other packages that have 'conan' in them, like conan_server",
      "[ `python -m pip freeze | grep 'conan='` ] || python -m pip install conan",
      "[ `python -m pip freeze | grep 'mkdoxy'` ] || python -m pip install mkdoxy"
    ],
    "scripts": {
      "build": [
        "${DEVBOX_PROJECT_ROOT}/scripts/build.bash $@"
      ],
      "test": [
        "echo \"Fuzzing. Mutation. etc?\""
      ],
      "line-report": [
        "cloc --vcs=git"
      ],
      "ci": [
        "gitlab-ci-local --volume personal_conan_cache:/root/.conan2 $@"
      ],
      "purge": [
        "rm -rf build cmake-* .gitlab-ci-local site CMakeUserPresets.json conan_provider.cmake output_final"
      ],
      "reset": [
        "devbox run purge",
        "rm -rf .venv .devbox"
      ],
      "list": [
        "jq -r '.shell.scripts|keys[]' devbox.json"
      ]
    }
  }
}
